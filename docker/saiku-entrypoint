#!/usr/bin/env bash
# Saiku demo container entrypoint.
#
# Dispatches the container's argv to the bundled launcher JAR:
#
#   serve            -> saiku launcher (REST + UI + native MCP on :8080)
#                       Forwards any extra args to the launcher's
#                       Picocli `serve` subcommand.
#   <anything else>  -> exec'd verbatim, useful for `docker run --rm
#                       saiku java -version` style introspection.
#
# Default CMD is `serve` (see Dockerfile). The MCP stdio binary has been
# folded into saiku-webapp as a native HTTP endpoint at /rest/saiku/api/mcp
# (issue #878), so the old `mcp` subcommand is gone — point MCP hosts at
# https://<host>/rest/saiku/api/mcp with per-user Basic auth instead.
set -euo pipefail

case "${1:-serve}" in
  serve)
    shift || true

    # ------------------------------------------------------------------
    # Fail-closed saiku-home pre-flight (#1989 SEC review S2b, CWE-250).
    #
    # The container runs as a non-root uid (10001). Docker only seeds image
    # ownership into a *fresh, empty* volume — a PRE-EXISTING volume or a
    # bind-mount created by an older root container keeps its root ownership.
    # If we booted anyway on such a home:
    #   * conf/secret.key (root, 0600) would be UNREADABLE -> the key provider
    #     silently generates a NEW AES key, and every stored datasource
    #     password fails to decrypt; the failed re-persist is swallowed.
    #   * in demo mode the admin/admin account is silently restored.
    # Docs won't be read, so refuse to start loudly instead. The operator
    # remediation is a one-off chown of the host dir / named volume to 10001.
    #
    # A genuinely fresh, empty home (no secret.key yet) MUST still boot: we
    # only fail on a home that exists-but-isn't-writable, or a secret.key that
    # exists-but-isn't-readable. POSIX test operators throughout.
    SAIKU_HOME_DIR="${SAIKU_HOME:-/app/saiku-home}"
    if [ -e "$SAIKU_HOME_DIR" ] && [ ! -w "$SAIKU_HOME_DIR" ]; then
      echo "FATAL: SAIKU_HOME '$SAIKU_HOME_DIR' is not writable by uid $(id -u):$(id -g)." >&2
      echo "       This is usually a saiku-home from an older root container that has not" >&2
      echo "       been re-owned for the non-root runtime user (uid/gid 10001)." >&2
      echo "       Bind mount:   sudo chown -R 10001:10001 <host-dir>" >&2
      echo "       Named volume: docker run --rm -v <vol>:/app/saiku-home --user 0 \\" >&2
      echo "                       --entrypoint chown <image> -R 10001:10001 /app/saiku-home" >&2
      exit 1
    fi
    if [ -e "$SAIKU_HOME_DIR/conf/secret.key" ] && [ ! -r "$SAIKU_HOME_DIR/conf/secret.key" ]; then
      echo "FATAL: '$SAIKU_HOME_DIR/conf/secret.key' exists but is not readable by uid $(id -u):$(id -g)." >&2
      echo "       Booting would rotate the AES key and orphan every stored datasource password." >&2
      echo "       Re-own the whole saiku-home to the runtime user: chown -R 10001:10001 '$SAIKU_HOME_DIR'" >&2
      exit 1
    fi
    # ------------------------------------------------------------------

    # Preserve any user-supplied JAVA_OPTS BEFORE we rebuild the array
    # with the well-known capability props below. Without this, anything
    # the operator passes via `-e JAVA_OPTS='-Dsaiku.ai.ask.provider=anthropic'`
    # (or any other Spring placeholder override / JVM tuning flag) is
    # silently dropped. word-splits the env var into an array so flags
    # with spaces survive intact.
    USER_JAVA_OPTS=()
    if [[ -n "${JAVA_OPTS:-}" ]]; then
      # shellcheck disable=SC2206  # intentional word-split
      USER_JAVA_OPTS=( ${JAVA_OPTS} )
    fi

    # Capability props surfaced by GET /rest/saiku/info/capabilities so
    # the SPA's admin panel + (when on) demo-mode login screen can show
    # accurate connection instructions. Empty values are passed through
    # as empty strings so the resource code's blank-check treats them
    # as "not configured".
    JAVA_OPTS=()
    if [[ -n "${SAIKU_DEMO:-}" ]]; then
      JAVA_OPTS+=("-Dsaiku.demo=${SAIKU_DEMO}")
    fi
    # saiku#1953: SAIKU_SEED gates the demo fixtures (FoodMart/Bank/TPC-DS/Flights).
    # Unset means "follow demo mode", so the common cases need nothing here; passed
    # through for the operator who wants fixtures without demo mode (SAIKU_SEED=true)
    # or the demo login against their own cubes (SAIKU_DEMO=true SAIKU_SEED=false).
    if [[ -n "${SAIKU_SEED:-}" ]]; then
      JAVA_OPTS+=("-Dsaiku.seed=${SAIKU_SEED}")
    fi
    if [[ -n "${SAIKU_MCP_URL:-}" ]]; then
      JAVA_OPTS+=("-Dsaiku.mcp.url=${SAIKU_MCP_URL}")
    fi
    # OpenTelemetry: attach the side-loaded Java agent only when an OTLP
    # endpoint is configured. With no endpoint, the agent jar is never
    # loaded — zero startup cost, zero runtime overhead. OTEL_SERVICE_NAME
    # defaults to "saiku" so traces are attributed correctly without
    # forcing every deployer to set it. All other OTEL_* env vars
    # (sampler, headers, resource attrs) pass through to the agent
    # untouched — see docs/observability.md.
    OTEL_AGENT_JAR=/opt/saiku/otel/opentelemetry-javaagent.jar
    if [[ -n "${OTEL_EXPORTER_OTLP_ENDPOINT:-}" && -f "$OTEL_AGENT_JAR" ]]; then
      JAVA_OPTS+=("-javaagent:${OTEL_AGENT_JAR}")
      export OTEL_SERVICE_NAME="${OTEL_SERVICE_NAME:-saiku}"
    fi
    # Append user JAVA_OPTS last so they can override the built-ins
    # (e.g. overriding -Dsaiku.demo from an env var stays possible).
    if [[ ${#USER_JAVA_OPTS[@]} -gt 0 ]]; then
      JAVA_OPTS+=( "${USER_JAVA_OPTS[@]}" )
    fi
    exec java "${JAVA_OPTS[@]}" -jar /app/saiku.jar serve \
      --host 0.0.0.0 \
      --port 8080 \
      --home "${SAIKU_HOME:-/app/saiku-home}" \
      "$@"
    ;;
  *)
    exec "$@"
    ;;
esac
