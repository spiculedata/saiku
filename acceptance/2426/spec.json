{
  "issue": 2426,
  "title": "Login rate-limiter buckets are bounded: an oversized username is clamped before it becomes a key",
  "kind": "api",
  "criteria": [
    {
      "id": "C1",
      "given": "a client address that has exhausted its failure budget with one oversized username (more than 256 characters)",
      "then": "a second oversized username sharing the same 256-character prefix is already locked out (429): the submitted username was bounded before use as a bucket key instead of being stored whole, so attacker-supplied usernames cannot grow the limiter's memory without bound"
    }
  ],
  "steps": [
    {
      "name": "repeated bad Basic credentials for an oversized username (1000 chars) trip the lockout for that user",
      "criterion": "C1",
      "request": {
        "method": "GET",
        "path": "/rest/saiku/info",
        "headers": { "Authorization": "Basic " }
      },
      "repeat": { "count": 12, "untilStatus": 429 },
      "expect": { "status": 429 }
    },
    {
      "name": "a second oversized username sharing the same 256-character prefix is already locked out",
      "criterion": "C1",
      "request": {
        "method": "GET",
        "path": "/rest/saiku/info",
        "headers": { "Authorization": "Basic " }
      },
      "expect": { "status": 429 }
    }
  ]
}
