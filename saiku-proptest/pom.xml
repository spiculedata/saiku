<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.saikuanalytics</groupId>
    <artifactId>saiku</artifactId>
    <version>4.6.3</version>
  </parent>

  <artifactId>saiku-proptest</artifactId>
  <version>4.6.3</version>
  <packaging>jar</packaging>
  <name>saiku-proptest</name>
  <description>
    Property-based tests (Hegel, https://hegel.dev) exercising real Saiku code.
    Test-only module: no main sources, never published. Requires JDK 22+ because
    Hegel uses the Foreign Function and Memory API + a bundled native engine, so
    this is the module that forces the reactor build onto JDK 22. Main artifacts
    still target release 21, so the shipped runtime is unaffected.
  </description>

  <properties>
    <hegel.version>0.4.0</hegel.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.saikuanalytics</groupId>
        <artifactId>saiku-bom</artifactId>
        <version>4.6.3</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <dependencies>
    <dependency>
      <groupId>dev.hegel</groupId>
      <artifactId>hegel</artifactId>
      <version>${hegel.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.junit.jupiter</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <!-- The Saiku code under test. Test scope: this module ships nothing. -->
    <dependency>
      <groupId>org.saikuanalytics</groupId>
      <artifactId>saiku-web</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.saikuanalytics</groupId>
      <artifactId>saiku-service</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.saikuanalytics</groupId>
      <artifactId>saiku-sql</artifactId>
      <version>${project.version}</version>
      <scope>test</scope>
    </dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <version>3.13.0</version>
        <!-- combine.self=override drops the root pom's inherited source/target 1.6
             so a bare <release> does not collide with the inherited source/target
             (the compiler plugin rejects having both set at once). -->
        <configuration combine.self="override">
          <release>22</release>
        </configuration>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-surefire-plugin</artifactId>
        <version>3.5.2</version>
        <configuration>
          <!-- Hegel calls native code via FFM; silence the JVM native-access warning. -->
          <argLine>--enable-native-access=ALL-UNNAMED</argLine>
        </configuration>
      </plugin>
      <!-- Test-only module: never deploy it to a repository. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-deploy-plugin</artifactId>
        <configuration>
          <skip>true</skip>
        </configuration>
      </plugin>
    </plugins>
  </build>
</project>
