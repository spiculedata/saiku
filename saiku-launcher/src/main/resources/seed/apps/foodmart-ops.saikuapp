{
  "name": "FoodMart Ops",
  "version": "1.0.0",
  "logo": null,
  "theme": {
    "mode": "light",
    "preset": "editorial",
    "customCss": "/* movers card — demo-specific composition the general skin doesn't cover */\n.tile:has(tbody) .tile-header{padding:14px 16px 4px;display:flex;flex-direction:column;align-items:flex-start;gap:0;}\n.tile:has(tbody) .tile-header span{font-family:var(--saiku-app-font-display,Georgia,serif);font-weight:700;font-size:1.05rem;color:var(--saiku-app-fg,#1f3529);text-transform:none;letter-spacing:0;}\n.tile:has(tbody) .tile-header::after{content:'Product department \\00B7 MoM';display:block;font-family:var(--saiku-app-font-body,sans-serif);font-size:.72rem;color:var(--saiku-app-muted,#a99e82);margin-top:2px;}\n.tile:has(tbody) thead{display:none;}\n.tile:has(tbody) tbody tr:nth-child(n+7){display:none;}\n.tile:has(tbody) tbody{counter-reset:mv;}\n.tile:has(tbody) tbody tr{counter-increment:mv;}\n.tile:has(tbody) tbody tr > :first-child{font-weight:600;color:var(--saiku-app-fg,#26332b);}\n.tile:has(tbody) tbody tr > :first-child::before{content:counter(mv);display:inline-block;width:20px;font-family:var(--saiku-app-font-display,Georgia,serif);font-style:italic;font-weight:400;color:#b6ab8d;}\n.tile:has(tbody) tbody tr:hover{background:#f7f3ea;}\n"
  },
  "nav": {
    "position": "rail",
    "railCollapsed": true,
    "footer": {
      "settings": true,
      "avatar": "RM"
    }
  },
  "assistantSlot": {
    "enabled": true,
    "title": "FoodMart",
    "persona": "Sales Analyst",
    "scope": "scoped to your stores",
    "greeting": "Morning. I'm scoped to your Pacific NW stores and the FoodMart Sales cube. Ask in plain English — I'll answer and update the dashboard. Try one of the prompts below.",
    "suggestedPrompts": [
      "How did Store Sales track last week vs the prior week?",
      "Break down Store Sales by Product Family for Q4.",
      "Which Product Department is up the most month-over-month?"
    ],
    "cube": {
      "connectionName": "unknown_foodmart",
      "catalog": "FoodMart",
      "schema": "FoodMart",
      "cubeName": "Sales"
    },
    "icon": "crosshair",
    "footerHint": "↵ to send · ⇧↵ new line",
    "poweredBy": "powered by Saiku",
    "skillPrompts": [
      "weekly foodmart rollup"
    ]
  },
  "pages": [
    {
      "id": "p1",
      "title": "Overview",
      "icon": "home",
      "heading": "Portland #14 · Today",
      "subheading": "Regional manager view · Pacific Northwest",
      "meta": "Thu · Week 41",
      "grid": {
        "cols": 12,
        "tiles": [
          {
            "id": "k1",
            "type": "kpi",
            "x": 0,
            "y": 0,
            "w": 3,
            "h": 2,
            "cube": {
              "connectionName": "unknown_foodmart",
              "catalog": "FoodMart",
              "schema": "FoodMart",
              "cubeName": "Sales"
            },
            "kpi": {
              "measure": "Store Sales",
              "measureCaption": "Store Sales",
              "format": "custom",
              "comparison": "prior-period",
              "direction": "higher-is-better",
              "sparkline": true,
              "timeLevel": {
                "dimension": "Time",
                "hierarchy": "Time",
                "level": "Month"
              },
              "thresholds": {},
              "customFormat": "$c1",
              "deltaSuffix": "vs last Thu"
            },
            "title": "Sales Today"
          },
          {
            "id": "k2",
            "type": "kpi",
            "x": 3,
            "y": 0,
            "w": 3,
            "h": 2,
            "cube": {
              "connectionName": "unknown_foodmart",
