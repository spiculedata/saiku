            "query": {
              "kind": "inline",
              "body": {
                "cube": {
                  "connectionName": "unknown_foodmart",
                  "catalog": "FoodMart",
                  "schema": "FoodMart",
                  "cubeName": "Sales"
                },
                "measures": [
                  {
                    "name": "Store Sales"
                  },
                  {
                    "name": "MoM Growth"
                  }
                ],
                "rows": [
                  {
                    "dimension": "Product",
                    "hierarchy": "Products",
                    "level": "Product Department"
                  }
                ],
                "columns": [],
                "filters": [
                  {
                    "dimension": "Time",
                    "hierarchy": "Time",
                    "level": "Month",
                    "members": [
                      "[Time].[Time].[1997].[Q4].[12]"
                    ]
                  }
                ]
              }
            },
            "conditionalFormat": [
              {
                "column": "MoM Growth",
                "type": "font",
                "thresholdMode": "absolute",
                "colors": {
                  "high": "#2e5e43",
                  "low": "#c85a3a",
                  "mid": "#93876c"
                }
              }
            ]
          }
        ]
