              "format": "number",
              "comparison": "prior-period",
              "direction": "higher-is-better",
              "sparkline": true,
              "timeLevel": {
                "dimension": "Time",
                "hierarchy": "Time",
                "level": "Month"
              },
              "thresholds": {},
              "deltaSuffix": "vs last Thu"
            },
            "title": "Units Sold"
          },
