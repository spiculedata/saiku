{
  "name": "FoodMart Ops",
  "version": "1.0.0",
  "logo": null,
  "theme": {
    "mode": "light",
    "preset": "editorial",
    "numerals": "mono",
    "kpiAccent": "tone"
  },
  "nav": {
    "position": "rail",
    "railCollapsed": true,
    "footer": {
      "settings": true,
      "avatarSource": "user"
    },
    "railFullHeight": true
  },
  "assistantSlot": {
    "enabled": true,
    "title": "FoodMart",
    "persona": "Sales Analyst",
    "scope": "scoped to your stores",
    "greeting": "Morning. I'm scoped to your Pacific NW stores and the FoodMart Sales cube. Ask in plain English — I'll answer and update the dashboard. Try one of the prompts below.",
    "suggestedPrompts": [
      "How did Store Sales track last week vs the prior week?",
      "Break down Store Sales by Product Family for Q4.",
      "Which Product Department is up the most month-over-month?"
    ],
    "cube": {
      "connectionName": "unknown_foodmart",
      "catalog": "FoodMart",
      "schema": "FoodMart",
      "cubeName": "Sales"
    },
    "icon": "crosshair",
    "footerHint": "↵ to send · ⇧↵ new line",
    "poweredBy": "powered by Saiku",
    "skillPrompts": [
      "weekly foodmart rollup"
    ]
  },
  "pages": [
    {
      "id": "p1",
      "title": "Overview",
      "icon": "home",
      "heading": "{context} · Overview",
      "subheading": "Regional manager view · Pacific Northwest",
      "meta": "{date:weekday} · Week {week}",
      "grid": {
        "cols": 12,
        "tiles": [
          {
            "id": "k1",
            "type": "kpi",
            "x": 0,
            "y": 0,
            "w": 3,
            "h": 2,
            "cube": {
              "connectionName": "unknown_foodmart",
              "catalog": "FoodMart",
              "schema": "FoodMart",
              "cubeName": "Sales"
            },
            "kpi": {
              "measure": "Store Sales",
              "measureCaption": "Store Sales",
              "format": "custom",
              "comparison": "prior-period",
              "direction": "higher-is-better",
              "sparkline": true,
              "timeLevel": {
                "dimension": "Time",
                "hierarchy": "Time",
                "level": "Month"
              },
              "thresholds": {},
              "customFormat": "$c1"
            },
            "title": "Store Sales"
          },
          {
            "id": "k2",
            "type": "kpi",
            "x": 3,
            "y": 0,
            "w": 3,
            "h": 2,
            "cube": {
              "connectionName": "unknown_foodmart",
              "catalog": "FoodMart",
              "schema": "FoodMart",
              "cubeName": "Sales"
            },
            "kpi": {
              "measure": "Unit Sales",
              "measureCaption": "Unit Sales",
              "format": "number",
              "comparison": "prior-period",
              "direction": "higher-is-better",
              "sparkline": true,
              "timeLevel": {
                "dimension": "Time",
                "hierarchy": "Time",
                "level": "Month"
              },
              "thresholds": {}
            },
            "title": "Units Sold"
