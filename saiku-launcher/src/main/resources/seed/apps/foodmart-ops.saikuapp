              "schema": "FoodMart",
              "cubeName": "Sales"
            },
            "query": {
              "kind": "inline",
              "body": {
                "cube": {
                  "connectionName": "unknown_foodmart",
                  "catalog": "FoodMart",
                  "schema": "FoodMart",
                  "cubeName": "Sales"
                },
                "measures": [
                  {
                    "name": "Store Sales"
                  }
                ],
                "rows": [
                  {
                    "dimension": "Time",
                    "hierarchy": "Time",
                    "level": "Month"
                  }
                ],
                "columns": [],
