          {
            "id": "t1",
            "type": "custom",
            "x": 0,
            "y": 2,
            "w": 8,
            "h": 4,
            "cube": {
              "connectionName": "unknown_foodmart",
              "catalog": "FoodMart",
              "schema": "FoodMart",
              "cubeName": "Sales"
            },
            "query": {
              "kind": "inline",
              "body": {
                "cube": {
                  "connectionName": "unknown_foodmart",
                  "catalog": "FoodMart",
                  "schema": "FoodMart",
                  "cubeName": "Sales"
                },
                "measures": [
                  {
                    "name": "Store Sales"
                  }
                ],
                "rows": [
                  {
                    "dimension": "Time",
                    "hierarchy": "Time",
                    "level": "Month"
                  }
                ],
                "columns": [],
                "filters": []
              }
            },
            "custom": {
              "renderer": "echarts-option",
              "options": {
                "title": {
                  "text": "Store Sales — this view",
                  "left": 16,
                  "top": 10,
                  "textStyle": {
                    "color": "#1f3529",
                    "fontFamily": "Georgia, serif",
                    "fontWeight": "bold",
                    "fontSize": 15
                  },
                  "subtext": "Monthly trend",
                  "subtextStyle": {
                    "color": "#8a7f68",
                    "fontSize": 11,
                    "fontFamily": "-apple-system,'Segoe UI',sans-serif"
                  }
                },
                "color": [
                  "#2e5e43",
                  "#c85a3a"
                ],
                "tooltip": {
                  "trigger": "axis"
                },
                "grid": {
                  "left": 60,
                  "right": 26,
                  "top": 66,
                  "bottom": 34
                },
                "xAxis": {
                  "type": "category",
                  "axisLabel": {
                    "color": "#8a7f68"
                  }
                },
                "yAxis": {
                  "type": "value",
                  "splitLine": {
                    "lineStyle": {
                      "color": "#efe9dc"
                    }
                  },
                  "axisLabel": {
                    "color": "#8a7f68"
                  }
                },
                "series": [
                  {
                    "type": "line",
                    "smooth": true,
                    "symbolSize": 7,
                    "lineStyle": {
                      "width": 3,
                      "color": "#2e5e43"
                    },
                    "itemStyle": {
                      "color": "#2e5e43"
                    },
                    "areaStyle": {
                      "color": "rgba(46,94,67,0.14)"
                    }
                  }
                ]
              },
              "trendBreakdown": true,
              "emphasizeLast": true
            }
          },
          {
            "id": "t2",
            "type": "table",
            "x": 8,
            "y": 2,
            "w": 4,
            "h": 4,
            "cube": {
              "connectionName": "unknown_foodmart",
              "catalog": "FoodMart",
              "schema": "FoodMart",
              "cubeName": "Sales"
            },
            "query": {
              "kind": "inline",
              "body": {
                "cube": {
                  "connectionName": "unknown_foodmart",
                  "catalog": "FoodMart",
                  "schema": "FoodMart",
                  "cubeName": "Sales"
                },
                "measures": [
                  {
                    "name": "MoM Growth"
                  }
                ],
                "rows": [
                  {
                    "dimension": "Product",
                    "hierarchy": "Products",
                    "level": "Product Department"
                  }
                ],
                "columns": [],
                "filters": [
                  {
                    "dimension": "Time",
                    "hierarchy": "Time",
                    "level": "Month",
                    "members": [
                      "[Time].[Time].[1997].[Q4].[12]"
                    ]
                  }
                ]
              }
            },
            "conditionalFormat": [
              {
                "column": "MoM Growth",
                "type": "font",
                "thresholdMode": "absolute",
                "colors": {
                  "high": "#2e5e43",
                  "low": "#c85a3a",
                  "mid": "#93876c"
                }
              }
            ],
            "title": "Movers"
          }
        ]
