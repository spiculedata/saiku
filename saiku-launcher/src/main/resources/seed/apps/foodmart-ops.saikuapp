            "h": 2,
            "cube": {
              "connectionName": "unknown_foodmart",
              "catalog": "FoodMart",
              "schema": "FoodMart",
              "cubeName": "Sales"
            },
            "kpi": {
              "measure": "Sales Count",
              "measureCaption": "Sales Count",
              "format": "number",
              "comparison": "prior-period",
              "direction": "higher-is-better",
              "sparkline": true,
              "timeLevel": {
                "dimension": "Time",
                "hierarchy": "Time",
                "level": "Month"
              },
              "thresholds": {}
            },
            "title": "Baskets"
          },
          {
            "id": "k4",
            "type": "kpi",
            "x": 9,
            "y": 0,
            "w": 3,
            "h": 2,
            "cube": {
              "connectionName": "unknown_foodmart",
              "catalog": "FoodMart",
              "schema": "FoodMart",
              "cubeName": "Sales"
            },
            "kpi": {
              "measure": "Customer Count",
              "measureCaption": "Customer Count",
              "format": "number",
              "comparison": "prior-period",
              "direction": "higher-is-better",
              "sparkline": true,
              "timeLevel": {
                "dimension": "Time",
                "hierarchy": "Time",
                "level": "Month"
              },
              "thresholds": {}
            },
            "title": "Customers"
          },
          {
            "id": "t1",
            "type": "custom",
            "x": 0,
            "y": 2,
            "w": 8,
            "h": 4,
            "cube": {
              "connectionName": "unknown_foodmart",
              "catalog": "FoodMart",
              "schema": "FoodMart",
              "cubeName": "Sales"
            },
            "query": {
              "kind": "inline",
              "body": {
                "cube": {
                  "connectionName": "unknown_foodmart",
                  "catalog": "FoodMart",
                  "schema": "FoodMart",
                  "cubeName": "Sales"
                },
                "measures": [
                  {
                    "name": "Store Sales"
                  }
                ],
                "rows": [
                  {
                    "dimension": "Time",
                    "hierarchy": "Weekly",
                    "level": "Week",
                    "members": [
                      "[Time].[Weekly].[1997].[34]",
                      "[Time].[Weekly].[1997].[35]",
                      "[Time].[Weekly].[1997].[36]",
                      "[Time].[Weekly].[1997].[37]",
                      "[Time].[Weekly].[1997].[38]",
                      "[Time].[Weekly].[1997].[39]",
                      "[Time].[Weekly].[1997].[40]",
                      "[Time].[Weekly].[1997].[41]"
                    ]
                  }
                ],
                "columns": [],
                "filters": []
              }
            },
            "custom": {
              "renderer": "echarts-option",
              "options": {
                "title": {
                  "text": "Store Sales — this view",
                  "left": 16,
                  "top": 10,
                  "textStyle": {
                    "fontWeight": "bold",
                    "fontSize": 15
                  },
                  "subtext": "Weekly trend · last 8 weeks",
                  "subtextStyle": {
                    "fontSize": 11
                  }
                },
                "tooltip": {
                  "trigger": "axis"
                },
                "grid": {
                  "left": 60,
                  "right": 26,
                  "top": 66,
                  "bottom": 34
                },
                "xAxis": {
                  "type": "category",
                  "axisLabel": {
                    "formatter": "W{value}"
                  }
                },
                "yAxis": {
                  "type": "value",
                  "scale": true
                },
                "series": [
                  {
                    "type": "line",
                    "smooth": true,
                    "symbolSize": 7,
                    "lineStyle": {
                      "width": 3
                    },
                    "areaStyle": {
                      "opacity": 0.14
                    }
                  }
                ]
              },
              "trendBreakdown": true,
              "emphasizeLast": true,
              "valueFormat": "$c1"
            }
          },
          {
            "id": "t2",
            "type": "custom",
            "x": 8,
            "y": 2,
            "w": 4,
            "h": 4,
            "cube": {
              "connectionName": "unknown_foodmart",
              "catalog": "FoodMart",
              "schema": "FoodMart",
              "cubeName": "Sales"
            },
            "query": {
              "kind": "inline",
              "body": {
                "cube": {
                  "connectionName": "unknown_foodmart",
                  "catalog": "FoodMart",
                  "schema": "FoodMart",
                  "cubeName": "Sales"
                },
                "measures": [
                  {
                    "name": "MoM Growth"
                  }
                ],
                "rows": [
                  {
                    "dimension": "Product",
                    "hierarchy": "Products",
                    "level": "Product Department"
                  }
                ],
                "columns": [],
                "filters": [
                  {
                    "dimension": "Time",
                    "hierarchy": "Time",
                    "level": "Month",
                    "members": [
                      "[Time].[Time].[1997].[Q4].[12]"
                    ]
                  }
                ]
              }
            },
            "custom": {
              "renderer": "ranked-list",
              "options": {
                "subtitle": "Product department · MoM",
                "limit": 6,
                "sort": "none",
                "tone": "signed",
                "showRank": true
              }
            },
            "title": "Movers"
          }
        ]
      }
