            "w": 3,
            "h": 2,
            "cube": {
              "connectionName": "unknown_foodmart",
              "catalog": "FoodMart",
              "schema": "FoodMart",
              "cubeName": "Sales"
            },
            "kpi": {
              "measure": "Store Sales",
              "measureCaption": "Store Sales",
              "format": "currency",
              "comparison": "prior-period",
              "direction": "higher-is-better",
              "sparkline": true,
              "timeLevel": {
