{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "defaultMode": "default",
    "disableBypassPermissionsMode": "disable",
    "allow": [
      "Read",
      "Glob",
      "Grep",
      "TodoWrite",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git blame:*)",
      "Bash(git fetch:*)",
      "Bash(git branch:*)",
      "Bash(git worktree list:*)",
      "Bash(git grep:*)",
      "Bash(mvn -v:*)",
      "Bash(mvn verify:*)",
      "Bash(mvn -B:*)",
      "Bash(mvn -pl:*)",
      "Bash(mvn spotless:apply:*)",
      "Bash(mvn spotless:check:*)",
      "Bash(mvn help:evaluate:*)",
      "Bash(mvn versions:set:*)",
      "Bash(npm run check:*)",
      "Bash(npm run lint:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)",
      "Bash(node --version:*)",
      "Bash(java -version:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr create:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh api:*)"
    ],
    "ask": [
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git stash:*)",
      "Bash(git tag:*)",
      "Bash(mvn clean:*)",
      "Bash(mvn install:*)",
      "Bash(mvn package:*)",
      "Bash(npm install:*)",
      "Bash(npm ci:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(docker:*)",
      "Bash(pkill:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(./**/*.pem)",
      "Read(./**/*.key)",
      "Read(./**/id_rsa*)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.ssh/**)",
      "Bash(git push --force:*)",
      "Bash(mvn deploy:*)",
      "Bash(gh secret:*)",
      "Edit(./.claude/settings.json)",
      "Write(./.claude/settings.json)",
      "Edit(./.claude/settings.local.json)",
      "Write(./.claude/settings.local.json)"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/agent-guard.sh\" bash",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Edit|Write|MultiEdit|NotebookEdit",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"${CLAUDE_PROJECT_DIR:-.}/scripts/agent-guard.sh\" edit",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
