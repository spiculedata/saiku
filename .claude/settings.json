{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git branch --list:*)",
      "Bash(git blame:*)",
      "Bash(git fetch upstream)",
      "Bash(mvn --version)",
      "Bash(mvn spotless:apply)",
      "Bash(mvn -DskipTests package:*)",
      "Bash(mvn -pl :*)",
      "Bash(npm run check)",
      "Bash(npm run lint)",
      "Bash(npm test)",
      "Bash(npm run build)",
      "Bash(npx svelte-kit sync)",
      "Bash(gh pr view:*)",
      "Bash(gh pr checks:*)",
      "Bash(gh issue view:*)",
      "Bash(gh repo view:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(grep:*)",
      "Bash(rg:*)",
      "Bash(find:*)"
    ],
    "ask": [
      "Bash(git checkout:*)",
      "Bash(git switch:*)",
      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git stash:*)",
      "Bash(git merge:*)",
      "Bash(git rebase:*)",
      "Bash(git reset:*)",
      "Bash(git push:*)",
      "Bash(git worktree:*)",
      "Bash(mvn deploy:*)",
      "Bash(mvn verify:*)",
      "Bash(mvn clean:*)",
      "Bash(mvn jgitflow:*)",
      "Bash(npm install)",
      "Bash(npm ci)",
      "Bash(gh pr create:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh pr ready:*)",
      "Bash(gh release:*)",
      "Bash(gh workflow:*)",
      "Edit(.github/workflows/**)",
      "Edit(.github/PULL_REQUEST_TEMPLATE.md)",
      "Edit(pom.xml)",
      "Edit(**/pom.xml)",
      "Edit(.mvn/**)",
      "WebFetch"
    ],
    "deny": [
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push upstream main:*)",
      "Bash(git push upstream development:*)",
      "Bash(git push origin main:*)",
      "Bash(git push origin development:*)",
      "Bash(git commit --no-verify:*)",
      "Bash(git commit --amend --no-edit:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr merge --admin:*)",
      "Bash(gh release create:*)",
      "Bash(gh workflow run:*)",
      "Bash(mvn deploy)",
      "Bash(rm -rf:*)",
      "Bash(rm -fr:*)",
      "Bash(git clean -fd:*)",
      "Bash(git reset --hard:*)",
      "Bash(chmod 777:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(./scripts/install-hooks.sh)",
      "Bash(npm publish:*)",
      "Bash(docker push:*)",
      "Bash(sudo:*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(**/.env)",
      "Read(**/.env.*)",
      "Read(~/.m2/settings.xml)",
      "Read(~/.ssh/**)",
      "Read(~/.aws/**)",
      "Read(~/.npmrc)",
      "Read(**/*.pem)",
      "Read(**/*.key)",
      "Read(**/*.p12)",
      "Read(**/id_rsa*)"
    ]
  }
}
