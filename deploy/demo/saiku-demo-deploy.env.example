# /etc/saiku-demo-deploy.env  - root:root, mode 0600.  Every line is optional.
# Loaded by systemd (EnvironmentFile=); values are NOT quoted and NOT shell-expanded.

# Slack incoming-webhook (or any endpoint accepting {"text": "..."}). Called only on a
# state change: a failed deploy, or the first success after a failure.
#SAIKU_DEPLOY_WEBHOOK_URL=https://hooks.slack.com/services/XXX/YYY/ZZZ

# Extra runtime env for the REAL container (docker --env-file format), e.g. AI provider
# keys the demo has today. Root-owned, 0600. Not given to the throwaway candidate.
#SAIKU_RUNTIME_ENV_FILE=/etc/saiku-demo.env

# Tar the (stopped) saiku-home here before each swap; the newest SAIKU_HOME_BACKUP_KEEP
# (default 2) are kept. Recommended: the home is the only state that is not redeployable.
#SAIKU_HOME_BACKUP_DIR=/var/backups/saiku-demo

# Also check the public URL (through Caddy) after a deploy; a failure only logs a warning.
#SAIKU_PUBLIC_URL=https://demo.saiku.bi

# Tunables (defaults shown).
#SAIKU_CANDIDATE_MEMORY=1536m
#SAIKU_FAIL_BACKOFF_SECONDS=3600
#SAIKU_KEEP_IMAGES=3
#SAIKU_HEALTH_ATTEMPTS=60
#SAIKU_HEALTH_INTERVAL=5
