{
	"name": "saiku-ui",
	"private": true,
	"version": "3.20.0",
	"license": "Apache-2.0",
	"type": "module",
	"//workspaces": "design-system/ is the shared design system, published as @concepttocloud/saiku-design-system. It's a workspace rather than a `file:` dep so npm hoists svelte/bits-ui to one copy — two svelte installs make `Snippet` from the package structurally incompatible with `Snippet` in the app.",
	"workspaces": [
		"design-system"
	],
	"scripts": {
		"dev": "vite dev",
		"build:app": "vite build",
		"build:embed": "node scripts/build-embed.mjs",
		"build:embed-npm": "node scripts/stage-embed-npm.mjs",
		"build:embed-react-npm": "node scripts/stage-embed-react-npm.mjs",
		"//sbom": "saiku#2000: CycloneDX SBOM for the npm/UI half of what we ship. The Maven SBOM (saiku#1990) only sees the Java tree; this covers everything bundled into the war overlay (monaco, echarts, apache-arrow, …) plus the design-system workspace. scripts/sbom.mjs wraps cyclonedx-npm (`--omit dev` mirrors the Maven SBOM's test-scope exclusion — the SBOM describes what ships, not the build/test harness) and sidesteps SvelteKit 3's generated node_modules/$app. Output is CycloneDX 1.6 JSON, written OUTSIDE dist/ so vite's emptyOutDir can't wipe it and it never ends up as a served /ui/ asset.",
		"sbom": "node scripts/sbom.mjs",
		"build": "npm run build:app && npm run build:embed && npm run build:embed-npm && npm run build:embed-react-npm && npm run sbom",
		"preview": "vite preview",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:embed-react",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"check:embed-react": "tsc --noEmit --project src/embed-react/tsconfig.json",
		"test": "vitest run && npm run lint",
		"test:watch": "vitest",
		"coverage:unit": "node scripts/coverage-run.mjs unit",
		"coverage:browser": "node scripts/coverage-run.mjs browser",
		"coverage:compare": "node scripts/compare-coverage.mjs",
		"coverage:all": "node scripts/coverage-run.mjs all",
		"e2e": "playwright test",
		"e2e:live": "RUN_LIVE_E2E=1 playwright test",
		"e2e:ui": "playwright test --ui",
		"fuzz": "bash bombadil/run.sh",
		"lint:tokens": "node ./scripts/check-tokens.mjs",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build",
		"lint:eslint": "eslint .",
		"lint": "npm run lint:format && npm run lint:tokens && npm run lint:eslint",
		"format": "prettier --write .",
		"lint:format": "prettier --check ."
	},
	"devDependencies": {
		"@antithesishq/bombadil": "^0.7.10",
		"@chromatic-com/storybook": "^5.6.0",
		"@cyclonedx/cyclonedx-npm": "^6.0.1",
		"@eslint/compat": "^2.1.1",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.65.0",
		"@storybook/addon-a11y": "^10.6.6",
		"@storybook/addon-docs": "^10.6.6",
		"@storybook/addon-svelte-csf": "^5.1.6",
		"@storybook/sveltekit": "^10.6.6",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.1.1",
		"@sveltejs/vite-plugin-svelte": "^7.3.1",
		"@tailwindcss/vite": "^4.3.5",
		"@types/css-tree": "^3.2.0",
		"@types/node": "^26.6.6",
		"@vitest/coverage-v8": "^5.1.0",
		"eslint": "^10.14.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"fast-check": "^4.10.2",
		"globals": "^17.14.0",
		"happy-dom": "^21.0.4",
		"jsdom": "^30.1.2",
		"prettier": "^3.9.10",
		"prettier-plugin-svelte": "^4.1.1",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"storybook": "^10.6.1",
		"svelte": "^5.57.3",
		"svelte-check": "^4.7.8",
		"tailwindcss": "^4.3.1",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.72.1",
		"v8-to-istanbul": "^9.3.0",
		"vite": "^8.3.6",
		"vitest": "^5.0.3"
	},
	"dependencies": {
		"@concepttocloud/saiku-design-system": "*",
		"@lucide/svelte": "^1.68.0",
		"@xyflow/svelte": "^1.7.1",
		"apache-arrow": "^21.2.0",
		"bits-ui": "^2.20.6",
		"clsx": "^2.1.1",
		"css-tree": "^3.2.1",
		"dompurify": "^3.4.17",
		"echarts": "^6.0.0",
		"elkjs": "^0.12.1",
		"html-to-image": "^1.11.13",
		"jspdf": "^4.2.1",
		"monaco-editor": "^0.57.0",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^3.3.1",
		"yaml": "^2.9.1"
	},
	"overrides": {
		"dompurify": "$dompurify",
		"runed": {
			"@sveltejs/kit": "$@sveltejs/kit"
		},
		"ws": "^8.21.0"
	}
}
