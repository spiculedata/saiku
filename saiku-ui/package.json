{
  "name": "saiku-ui",
  "private": true,
  "version": "3.18.2",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build:app": "vite build",
    "build:embed": "vite build --config vite.config.embed.ts",
    "build:embed-npm": "node scripts/stage-embed-npm.mjs",
    "build": "npm run build:app && npm run build:embed && npm run build:embed-npm",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "devDependencies": {
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.60.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.1",
    "@types/node": "^25.6.0",
    "happy-dom": "^20.9.0",
    "svelte": "^5.2.7",
    "svelte-check": "^4.1.0",
    "typescript": "^5.7.2",
    "vite": "^6.4.2",
    "vitest": "^3.2.6"
  },
  "dependencies": {
    "apache-arrow": "^15.0.2",
    "echarts": "^6.0.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-svelte": "^1.0.1",
    "monaco-editor": "^0.55.1"
  },
  "overrides": {
    "dompurify": "^3.4.0",
    "cookie": "^0.7.2"
  }
}
