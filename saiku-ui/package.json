{
  "name": "saiku-ui",
  "private": true,
  "version": "3.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build:app": "vite build",
    "build:embed": "vite build --config vite.config.embed.ts",
    "build:embed-npm": "node scripts/stage-embed-npm.mjs",
    "build:embed-react-npm": "node scripts/stage-embed-react-npm.mjs",
    "build": "npm run build:app && npm run build:embed && npm run build:embed-npm && npm run build:embed-react-npm",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:embed-react",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:embed-react": "tsc --noEmit --project src/embed-react/tsconfig.json",
    "test": "vitest run && npm run lint",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:live": "RUN_LIVE_E2E=1 playwright test",
    "e2e:ui": "playwright test --ui",
    "lint:tokens": "node ./scripts/check-tokens.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:eslint": "eslint .",
    "lint": "npm run lint:tokens && npm run lint:eslint"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@storybook/addon-a11y": "^10.5.3",
    "@storybook/addon-docs": "^10.5.3",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/sveltekit": "^10.5.3",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.1",
    "@sveltejs/vite-plugin-svelte": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.1.1",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^29.1.1",
    "storybook": "^10.4.6",
    "svelte": "^5.56.7",
    "svelte-check": "^4.7.3",
    "tailwindcss": "^4.3.1",
    "typescript": "^7.0.2",
    "typescript-eslint": "^8.65.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "apache-arrow": "^21.2.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "echarts": "^6.0.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-svelte": "^1.0.1",
    "monaco-editor": "^0.56.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.2.2"
  },
  "overrides": {
    "dompurify": "^3.4.0",
    "cookie": "^0.7.2",
    "ws": "^8.21.0"
  }
}
