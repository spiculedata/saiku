{
  "name": "saiku-ui",
  "private": true,
  "version": "3.20.0",
  "type": "module",
  "scripts": {
    "dev": "vite dev",
    "build:app": "vite build",
    "build:embed": "vite build --config vite.config.embed.ts",
    "build:embed-npm": "node scripts/stage-embed-npm.mjs",
    "build:embed-react-npm": "node scripts/stage-embed-react-npm.mjs",
    "build": "npm run build:app && npm run build:embed && npm run build:embed-npm && npm run build:embed-react-npm",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json && npm run check:embed-react",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "check:embed-react": "tsc --noEmit --project src/embed-react/tsconfig.json",
    "test": "vitest run && npm run lint",
    "test:watch": "vitest",
    "e2e": "playwright test",
    "e2e:live": "RUN_LIVE_E2E=1 playwright test",
    "e2e:ui": "playwright test --ui",
    "fuzz": "bash bombadil/run.sh",
    "lint:tokens": "node ./scripts/check-tokens.mjs",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "lint:eslint": "eslint .",
    "lint": "npm run lint:tokens && npm run lint:eslint"
  },
  "devDependencies": {
    "@antithesishq/bombadil": "^0.6.1",
    "@chromatic-com/storybook": "^5.2.1",
    "@eslint/compat": "^2.1.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@storybook/addon-a11y": "^10.5.6",
    "@storybook/addon-docs": "^10.5.6",
    "@storybook/addon-svelte-csf": "^5.1.2",
    "@storybook/sveltekit": "^10.5.6",
    "@sveltejs/adapter-static": "^3.0.6",
    "@sveltejs/kit": "^2.70.2",
    "@sveltejs/vite-plugin-svelte": "^5.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/css-tree": "^2.3.11",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.22.0",
    "fast-check": "^4.9.0",
    "globals": "^17.9.0",
    "happy-dom": "^20.11.1",
    "jsdom": "^30.0.1",
    "storybook": "^10.5.5",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.1",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^6.4.3",
    "vitest": "^4.1.10"
  },
  "dependencies": {
    "@xyflow/svelte": "^1.6.0",
    "apache-arrow": "^21.2.0",
    "bits-ui": "^2.18.1",
    "clsx": "^2.1.1",
    "css-tree": "^3.2.1",
    "echarts": "^6.0.0",
    "elkjs": "^0.12.0",
    "html-to-image": "^1.11.13",
    "jspdf": "^4.2.1",
    "lucide-svelte": "^1.0.1",
    "monaco-editor": "^0.56.0",
    "tailwind-merge": "^3.6.0",
    "tailwind-variants": "^3.3.0",
    "yaml": "^2.9.0"
  },
  "overrides": {
    "dompurify": "^3.4.0",
    "cookie": "^0.7.2",
    "ws": "^8.21.0"
  }
}
